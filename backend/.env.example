# Copy this file to .env and replace every placeholder. Never commit backend/.env.
AWS_ACCESS_KEY_ID=replace_with_your_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_your_secret_access_key
AWS_DEFAULT_REGION=ap-south-1
CLOUDSENTINEL_ASG_NAME=replace_with_your_auto_scaling_group_name
CLOUDSENTINEL_RECOVERY_THRESHOLD_SECONDS=180
CLOUDSENTINEL_ALB_DNS_NAME=replace_with_your_alb_dns_name
CLOUDSENTINEL_TRAFFIC_SHIFT_THRESHOLD_SECONDS=60
CLOUDSENTINEL_TRAFFIC_OBSERVATION_SECONDS=30
CLOUDSENTINEL_REBOOT_RECOVERY_THRESHOLD_SECONDS=60
CLOUDSENTINEL_SCALE_ASG_THRESHOLD_SECONDS=300
# Test 6: CPU stress -> CloudWatch alarm -> ASG scale-out
CLOUDSENTINEL_CPU_ALARM_NAME=replace_with_your_cloudwatch_alarm_name
CLOUDSENTINEL_CPU_STRESS_DURATION_SECONDS=360
CLOUDSENTINEL_CPU_SCALE_OUT_THRESHOLD_SECONDS=300
CLOUDSENTINEL_CPU_TEST_TIMEOUT_SECONDS=900
# Test 7: temporary Security Group block for one target only
CLOUDSENTINEL_TEST7_SECURITY_GROUP_ID=sg-replace_with_a_dedicated_test7_security_group
CLOUDSENTINEL_SG_BLOCK_THRESHOLD_SECONDS=60
CLOUDSENTINEL_SG_OBSERVATION_SECONDS=30
